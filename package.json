{
  "name": "axle-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A proof-of-concept TUI coding agent built on Axle, used to stress-test Axle's UI contract.",
  "packageManager": "pnpm@11.10.0",
  "bin": {
    "axle-code": "bin/axle-code.mjs"
  },
  "scripts": {
    "headless": "tsx src/headless.ts",
    "dev": "tsx src/index.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fifthrevision/axle": "^0.29.0",
    "chalk": "^6.0.0",
    "dotenv": "^17.0.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "markdansi": "^0.3.3",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
